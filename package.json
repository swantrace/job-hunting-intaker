{
  "name": "job-hunting-intaker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build",
    "smoke": "bun scripts/smoke.ts",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "format": "biome check --write --unsafe --error-on-warnings .",
    "format:check": "biome check --error-on-warnings ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/bun": "^1.3.14",
    "daisyui": "^5.7.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "bun run format -- --no-errors-on-unmatched"
  }
}
